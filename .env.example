# Copy to .env and fill in. Never commit the real .env file.

# Django settings module (manage.py defaults to endeavours.settings.dev)
DJANGO_SETTINGS_MODULE=endeavours.settings.dev

# Secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

DEBUG=True

# Comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL for dev and production.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Staging may instead use: sqlite:///staging.sqlite3
DATABASE_URL=postgres://user:password@localhost:5432/wagtail_cms

# Absolute URL of the site, no trailing slash and no /admin suffix.
WAGTAILADMIN_BASE_URL=http://localhost:8000

TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# Paths (optional - sensible defaults are used)
# STATIC_ROOT=/var/www/endeavours/static
# MEDIA_ROOT=/var/www/endeavours/media

# Email (production)
DEFAULT_FROM_EMAIL=noreply@endeavours.example
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Production TLS
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# Seed command overrides (optional).
# `make seed` creates this admin user. Defaults are admin / admin123456 and are
# intended for local development only - override them anywhere else.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@endeavours.example
# SEED_ADMIN_PASSWORD=change-me
